# Copy this file to fastlane/.env (git-ignored) and fill it in. Paths may start with ~. See RELEASING.md.

# iOS / TestFlight: an App Store Connect API key.
# App Store Connect -> Users and Access -> Integrations -> App Store Connect API -> Team Keys -> (+), role "Admin" (App Manager can upload but cannot create distribution certificates).
# Download the .p8 once (Apple won't show it again) and keep it outside the repo.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.trustmail/AuthKey_XXXXXXXXXX.p8

# Android / Google Play: the JSON key of a service account with release access (see RELEASING.md).
PLAY_JSON_KEY=~/.trustmail/play-service-account.json

# Optional defaults
# PLAY_TRACK=internal            # internal | alpha (closed testing) | beta (open testing) | production
# PLAY_RELEASE_STATUS=completed  # use draft until the app's store listing is complete
# TESTFLIGHT_GROUPS=Friends      # external TestFlight groups to send each build to (needs Beta App Review)
# IOS_SIMULATOR=iPhone 17        # simulator for the unit tests
