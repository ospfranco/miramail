<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used by `xcodebuild -exportArchive` to sign for the App Store and upload straight to App Store Connect
	     (TestFlight). See RELEASING.md. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>24CMR7378R</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- Versions come from the project (MARKETING_VERSION / CURRENT_PROJECT_VERSION), not from Xcode. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
